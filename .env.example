# Frontend (Vite) reads this. Set by `npx convex dev` automatically in .env.local.
VITE_CONVEX_URL=

# Backend variables live on the Convex deployment, not in this file:
#   npx convex env set FIRECRAWL_API_KEY fc-...
#   npx convex env set AGENTMAIL_API_KEY am_...
#   npx convex env set AGENTMAIL_WEBHOOK_SECRET whsec_...
#   npx convex env set OPENAI_API_KEY sk-...           (optional, enables model summaries)
#   npx convex env set OPENAI_BASE_URL https://...     (optional, any OpenAI-compatible endpoint)
#   npx convex env set OPENAI_MODEL gpt-5-mini         (optional)
#   npx convex env set APP_URL https://<deployment>.convex.site
